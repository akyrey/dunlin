SELECT * FROM "main"."Order Items" WHERE (id > 0) AND "spaced ""name""" <= ?1 AND ("spaced ""name""" < ?2 OR ("spaced ""name""" = ?3 AND "id" > ?4) OR ("spaced ""name""" = ?5 AND "id" = ?6 AND "select" > ?7)) ORDER BY "spaced ""name""" DESC, "id", "select" LIMIT 200
