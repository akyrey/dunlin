SELECT * FROM `shop`.`Order Items` WHERE (id > 0) AND `spaced "name"` <= ? AND (`spaced "name"` < ? OR (`spaced "name"` = ? AND `id` > ?) OR (`spaced "name"` = ? AND `id` = ? AND `select` > ?)) ORDER BY `spaced "name"` DESC, `id`, `select` LIMIT 200
