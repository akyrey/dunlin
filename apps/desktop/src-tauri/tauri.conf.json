{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dunlin",
  "identifier": "dev.dunlin.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dunlin",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A desktop client for PostgreSQL, MySQL, SQLite and Redis",
    "longDescription": "Dunlin is a desktop database client for PostgreSQL, MySQL, MariaDB, SQLite and Redis, with SSH tunnels, TLS, a SQL editor, a table data grid with editing, and import and export.",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQTBCNEYzNDlGRDRGNEYKUldSUFQvMUo4N1NnYlpLV0Zrb0ZielRpWXFsZUkyc3ljQnJSUnhneVZRT1pYTzc0OVlra2RMVzkK",
      "endpoints": [
        "https://github.com/akyrey/dunlin/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
